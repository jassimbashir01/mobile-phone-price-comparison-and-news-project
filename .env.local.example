# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Cloudinary ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Launch control ────────────────────────────────────────────────────────
# "true"  → normal indexing, IndexNow active
# anything else → X-Robots-Tag: noindex,nofollow sitewide + IndexNow paused
# Keep this false while catalogue data is being verified in production.
NEXT_PUBLIC_SITE_LIVE=false

# ── On-demand ISR revalidation ────────────────────────────────────────────
REVALIDATE_SECRET=your-own-random-secret

# ── IndexNow (Bing/Yandex instant indexing) ───────────────────────────────
INDEXNOW_KEY=your-own-random-key

# ── Google AdSense ────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-0000000000000000

# ── Analytics ─────────────────────────────────────────────────────────────
# Set ONLY ONE of these two, never both — running GA4 directly alongside
# GTM double-counts every pageview. If you want both GA4 and other tags
# (Meta Pixel, etc.), set up GA4 *inside* your GTM container instead and
# leave NEXT_PUBLIC_GA4_ID blank.
#
# GA4: Google Analytics → Admin → Data Streams → your web stream → Measurement ID
# NEXT_PUBLIC_GA4_ID=
# GTM: Google Tag Manager → Container → Container ID (top left, format GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=